---
const socials = [
  {
    name: 'GitHub',
    url: 'https://github.com/ibystm',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/></svg>`,
  },
];
---

<div
  style="
    position: fixed;
    bottom: 0;
    left: 2.5rem;
    z-index: 10;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  "
>
  {
    socials.map((social) => (
      <a
        href={social.url}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={social.name}
        style="
          color: var(--color-slate-light);
          transition: all 0.25s cubic-bezier(0.645, 0.045, 0.355, 1);
          display: block;
        "
        onmouseover="this.style.color='var(--color-accent)'; this.style.transform='translateY(-3px)'"
        onmouseout="this.style.color='var(--color-slate-light)'; this.style.transform='translateY(0)'"
        set:html={social.icon}
      />
    ))
  }
  <div
    style="
      width: 1px;
      height: 90px;
      background-color: var(--color-slate-light);
      margin-top: 0.5rem;
    "
  ></div>
</div>
