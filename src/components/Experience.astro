---
import { jobs } from '../data/experience';
---

<section
  id="experience"
  class="section fade-in"
  style="padding: 6rem 6rem;"
>
  <h2 class="numbered-heading" data-number="02.">職歴</h2>

  <div style="display: flex; gap: 0; min-height: 340px;">
    <!-- タブリスト -->
    <div
      id="tab-list"
      role="tablist"
      aria-label="Job tabs"
      style="
        display: flex;
        flex-direction: column;
        min-width: 140px;
        border-left: 2px solid var(--color-navy-lighter);
      "
    >
      {
        jobs.map((job, i) => (
          <button
            role="tab"
            aria-selected={i === 0 ? 'true' : 'false'}
            data-tab={i}
            style={`
              background: transparent;
              border: none;
              border-left: 2px solid transparent;
              margin-left: -2px;
              padding: 0.75rem 1.25rem;
              font-family: var(--font-mono);
              font-size: 0.8125rem;
              color: ${i === 0 ? 'var(--color-accent)' : 'var(--color-slate)'};
              background-color: ${i === 0 ? 'var(--color-accent-tint)' : 'transparent'};
              border-left-color: ${i === 0 ? 'var(--color-accent)' : 'transparent'};
              text-align: left;
              cursor: pointer;
              transition: all 0.25s cubic-bezier(0.645, 0.045, 0.355, 1);
              white-space: nowrap;
            `}
          >
            {job.company}
          </button>
        ))
      }
    </div>

    <!-- タブパネル -->
    <div style="flex: 1; padding: 0 1.5rem 0 2rem;">
      {
        jobs.map((job, i) => (
          <div
            role="tabpanel"
            data-panel={i}
            style={`display: ${i === 0 ? 'block' : 'none'};`}
          >
            <!-- タイトル & 会社名 -->
            <h3
              style="
                font-size: 1.25rem;
                font-weight: 500;
                color: var(--color-slate-lighter);
                margin: 0 0 0.25rem;
              "
            >
              {job.title}{' '}
              <span style="color: var(--color-accent);">
                @{' '}
                <a
                  href={job.companyUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  style="color: var(--color-accent); text-decoration: none;"
                  onmouseover="this.style.textDecoration='underline'"
                  onmouseout="this.style.textDecoration='none'"
                >
                  {job.company}
                </a>
              </span>
            </h3>

            <!-- 期間・雇用形態 -->
            <p
              style="
                font-family: var(--font-mono);
                font-size: 0.8125rem;
                color: var(--color-slate);
                margin: 0 0 0.625rem;
                display: flex;
                align-items: center;
                gap: 0.75rem;
              "
            >
              {job.period}
              <span style={`
                border-radius: 9999px;
                padding: 0.2rem 0.7rem;
                font-size: 0.75rem;
                font-weight: 500;
                ${job.employmentType === '正社員'
                  ? 'color: var(--color-accent); background-color: var(--color-accent-tint); border: 1px solid rgba(100, 255, 218, 0.3);'
                  : 'color: rgb(255, 200, 87); background-color: rgba(255, 200, 87, 0.08); border: 1px solid rgba(255, 200, 87, 0.3);'
                }
              `}>{job.employmentType}</span>
            </p>

            <!-- 会社概要 -->
            <p
              style="
                font-size: 0.875rem;
                color: var(--color-slate);
                line-height: 1.6;
                margin: 0 0 1.25rem;
                padding: 0.625rem 0.875rem;
                border-left: 2px solid var(--color-navy-lighter);
              "
            >
              {job.description}
            </p>

            <!-- 主な成果 -->
            {job.achievements && job.achievements.length > 0 && (
              <div
                style="
                  margin-bottom: 1.5rem;
                  padding: 1rem 1.25rem;
                  background: rgba(100, 255, 218, 0.04);
                  border: 1px solid rgba(100, 255, 218, 0.18);
                  border-radius: 6px;
                "
              >
                <p
                  style="
                    font-family: var(--font-mono);
                    font-size: 0.75rem;
                    color: var(--color-accent);
                    margin: 0 0 0.75rem;
                  "
                >
                  主な成果
                </p>
                <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.5rem;">
                  {job.achievements.map((achievement) => (
                    <li
                      style="
                        display: flex;
                        align-items: flex-start;
                        gap: 0.625rem;
                        font-size: 0.875rem;
                        line-height: 1.65;
                        color: var(--color-slate-lighter);
                      "
                    >
                      <span style="color: var(--color-accent); flex-shrink: 0; margin-top: 0.3rem; font-size: 0.6rem;">◆</span>
                      {achievement}
                    </li>
                  ))}
                </ul>
              </div>
            )}

            <!-- 箇条書き -->
            <ul style="list-style: none; padding: 0; margin: 0 0 1.5rem;">
              {job.bullets.map((bullet) => (
                <li
                  style="
                    display: flex;
                    align-items: flex-start;
                    gap: 0.75rem;
                    margin-bottom: 0.75rem;
                    line-height: 1.7;
                    font-size: 0.9375rem;
                  "
                >
                  <span style="color: var(--color-accent); margin-top: 0.35rem; flex-shrink: 0;">▹</span>
                  {bullet}
                </li>
              ))}
            </ul>

            <!-- 使用技術バッジ -->
            <ul
              style="
                display: flex;
                flex-wrap: wrap;
                gap: 0.5rem;
                list-style: none;
                padding: 0;
                margin: 0;
              "
            >
              {job.tech.map((t) => (
                <li
                  style="
                    font-family: var(--font-mono);
                    font-size: 0.75rem;
                    color: var(--color-accent);
                    background-color: var(--color-accent-tint);
                    border: 1px solid rgba(100, 255, 218, 0.2);
                    border-radius: 9999px;
                    padding: 0.25rem 0.75rem;
                    line-height: 1.5;
                  "
                >
                  {t}
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>

<script>
  const tabs = document.querySelectorAll('[role="tab"]');
  const panels = document.querySelectorAll('[role="tabpanel"]');

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const index = Number((tab as HTMLElement).dataset.tab);

      tabs.forEach((t, i) => {
        const el = t as HTMLElement;
        const active = i === index;
        el.style.color = active ? 'var(--color-accent)' : 'var(--color-slate)';
        el.style.backgroundColor = active ? 'var(--color-accent-tint)' : 'transparent';
        el.style.borderLeftColor = active ? 'var(--color-accent)' : 'transparent';
        el.setAttribute('aria-selected', active ? 'true' : 'false');
      });

      panels.forEach((panel, i) => {
        (panel as HTMLElement).style.display = i === index ? 'block' : 'none';
      });
    });
  });
</script>
