---
import { otherProjects } from '../data/projects';

const folderIcon = `<svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg>`;
const externalIcon = `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>`;
const githubIcon = `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/></svg>`;
---

<section
  class="fade-in"
  style="padding: 0 6rem 6rem; max-width: 900px; margin: 0 auto;"
>
  <h3
    style="
      text-align: center;
      font-size: 1.625rem;
      font-weight: 600;
      color: var(--color-slate-lighter);
      margin-bottom: 0.75rem;
    "
  >
    その他のプロジェクト
  </h3>
  <p style="text-align: center; margin-bottom: 3rem;">
    <a
      href="https://github.com/yourusername"
      target="_blank"
      rel="noopener noreferrer"
      style="
        font-family: var(--font-mono);
        font-size: 0.875rem;
        color: var(--color-accent);
        text-decoration: none;
      "
      onmouseover="this.style.textDecoration='underline'"
      onmouseout="this.style.textDecoration='none'"
    >
      アーカイブを見る
    </a>
  </p>

  <ul
    style="
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      gap: 1rem;
      list-style: none;
      padding: 0;
      margin: 0;
    "
  >
    {
      otherProjects.map((project) => (
        <li>
          <div
            style="
              display: flex;
              flex-direction: column;
              justify-content: space-between;
              height: 100%;
              padding: 2rem 1.75rem;
              background-color: var(--color-navy-light);
              border-radius: 4px;
              transition: transform 0.25s cubic-bezier(0.645, 0.045, 0.355, 1);
              box-shadow: 0 10px 30px -15px rgba(2,12,27,0.7);
              cursor: default;
            "
            onmouseover="this.style.transform='translateY(-5px)'"
            onmouseout="this.style.transform='translateY(0)'"
          >
            <div>
              <div
                style="
                  display: flex;
                  justify-content: space-between;
                  align-items: flex-start;
                  margin-bottom: 2rem;
                "
              >
                <div style="color: var(--color-accent);" set:html={folderIcon} />
                <div style="display: flex; gap: 0.75rem;">
                  {project.github && (
                    <a
                      href={project.github}
                      target="_blank"
                      rel="noopener noreferrer"
                      aria-label="GitHub"
                      style="color: var(--color-slate-light); transition: color 0.25s;"
                      onmouseover="this.style.color='var(--color-accent)'"
                      onmouseout="this.style.color='var(--color-slate-light)'"
                      set:html={githubIcon}
                    />
                  )}
                  {project.external && (
                    <a
                      href={project.external}
                      target="_blank"
                      rel="noopener noreferrer"
                      aria-label="External link"
                      style="color: var(--color-slate-light); transition: color 0.25s;"
                      onmouseover="this.style.color='var(--color-accent)'"
                      onmouseout="this.style.color='var(--color-slate-light)'"
                      set:html={externalIcon}
                    />
                  )}
                </div>
              </div>

              <h3
                style="
                  font-size: 1.125rem;
                  font-weight: 600;
                  color: var(--color-slate-lighter);
                  margin: 0 0 0.625rem;
                  transition: color 0.25s;
                "
              >
                {project.title}
              </h3>

              <p style="font-size: 0.875rem; line-height: 1.7; margin: 0 0 1.5rem;">
                {project.description}
              </p>
            </div>

            <ul
              style="
                display: flex;
                flex-wrap: wrap;
                gap: 0.5rem 0.875rem;
                list-style: none;
                padding: 0;
                margin: 0;
              "
            >
              {project.tech.map((t) => (
                <li style="font-family: var(--font-mono); font-size: 0.6875rem; color: var(--color-slate);">
                  {t}
                </li>
              ))}
            </ul>
          </div>
        </li>
      ))
    }
  </ul>
</section>
